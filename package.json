{
  "name": "comify",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "scripts": {
    "clean": "npm run clean --workspaces --if-present",
    "clean-build": "rimraf artifacts/build",
    "clean-dist": "rimraf artifacts/dist",

    "build": "npm run compile && npm run bundle",

    "compile": "npm run compile-logic && npm run compile-app",
    "compile-logic": "npm run compile-logic --workspaces --if-present",
    "compile-app": "npm run compile-app --workspaces --if-present",

    "bundle": "npm run clean-dist && jitar build && npm run copy",
    "copy": "npm run copy-apps && npm run copy-assets",
    "copy-apps": "cpx 'artifacts/build/*/app/**/*' 'artifacts/dist'",
    "copy-assets": "cpx 'artifacts/build/*/assets/**/*' 'artifacts/dist'",

    "test": "vitest run",
    "test-coverage": "vitest run --coverage",
    "lint": "npm run lint --workspaces --if-present",
    "review": "npm run review --workspaces --if-present",

    "docker-up": "docker compose --env-file development.env up -d",
    "docker-down": "docker compose --env-file development.env down",
    
    "dev": "jitar start --env-file=development.env --service=deployment/services/development/worker.json --http-body-limit=512000",
    "demo": "jitar start --env-file=development.env --service=deployment/services/demonstration/social.json --http-body-limit=512000",

    "prod-start": "pm2 start ecosystem.config.cjs",
    "prod-stop": "pm2 stop ecosystem.config.cjs",
    "prod-down": "pm2 delete ecosystem.config.cjs",
    "prod-list": "pm2 list",
    "prod-monitor": "pm2 monit",

    "gateway": "jitar start --env-file=development.env --service=deployment/services/production/gateway.json --http-body-limit=512000",
    "bff": "jitar start --env-file=development.env --service=deployment/services/production/bff.json --http-body-limit=512000",
    "notification": "jitar start --env-file=development.env --service=deployment/services/production/notification.json --http-body-limit=512000",
    "reads": "jitar start --env-file=development.env --service=deployment/services/production/reads.json --http-body-limit=512000",
    "reads2": "jitar start --env-file=development.env --service=deployment/services/production/reads2.json --http-body-limit=512000",
    "writes": "jitar start --env-file=development.env --service=deployment/services/production/writes.json --http-body-limit=512000",
    "social-app": "jitar start --env-file=development.env --service=deployment/services/production/social-app.json --http-body-limit=512000",
    "proxy": "jitar start --env-file=development.env --service=deployment/services/production/proxy.json --http-body-limit=512000",

    "containerd": "jitar start --log-level=warn --service=service.json --http-body-limit=640000"
  },
  "workspaces": [
    "development/common",
    "development/insights",
    "development/social",
    "development/moderation",

    "testing/common",
    "testing/insights",
    "testing/moderation",
    "testing/social"
  ],
  "dependencies": {
    "@jitar-plugins/authentication": "^0.2.0",
    "@jitar-plugins/database": "^0.2.0",
    "@jitar-plugins/events": "^0.2.0",
    "@jitar-plugins/files": "^0.2.0",
    "@jitar-plugins/http": "^0.2.0",
    "@jitar-plugins/notification": "^0.2.0",
    "@maskingtech/designsystem": "^0.1.0",
    "@maskingtech/react-toolkit": "^0.0.5",
    "@theshelf/authentication": "^0.6.0",
    "@theshelf/authentication-driver-openid": "^0.6.0",
    "@theshelf/connection": "^0.6.0",
    "@theshelf/database": "^0.6.0",
    "@theshelf/database-driver-mongodb": "^0.6.0",
    "@theshelf/events": "^0.6.0",
    "@theshelf/events-driver-kafka": "^0.6.0",
    "@theshelf/files": "^0.6.0",
    "@theshelf/files-driver-s3": "^0.6.0",
    "@theshelf/http": "^0.6.0",
    "@theshelf/logging": "^0.6.0",
    "@theshelf/logging-driver-database": "^0.6.0",
    "@theshelf/notification": "^0.6.0",
    "@theshelf/validation": "^0.6.0",
    "@theshelf/validation-driver-zod": "^0.6.0",
    "dayjs": "^1.11.23",
    "jitar": "^0.11.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@jitar/plugin-vite": "^0.11.3",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^5.0.0",
    "cpx2": "^9.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "pm2": "^7.0.4",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@rollup/plugin-terser": "^1.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
